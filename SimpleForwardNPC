using UnityEngine;

public class SimpleForwardNPC : MonoBehaviour
{
    [Header("Здоровье")]
    public float maxHealth = 100f;
    public float currentHealth;

    [Header("Движение")]
    public float moveSpeed = 3f;

    void Start()
    {
        // Обновляем здоровье до максимума при старте игры
        ResetHealth();
    }

    void Update()
    {
        // Постоянное движение вперёд (по локальной оси Z объекта)
        transform.Translate(Vector3.forward * moveSpeed * Time.deltaTime);
    }

    // Метод для сброса/обновления здоровья
    public void ResetHealth()
    {
        currentHealth = maxHealth;
    }

    // Метод для получения урона (пригодится при атаках по NPC)
    public void TakeDamage(float damage)
    {
        currentHealth -= damage;

        if (currentHealth <= 0f)
        {
            currentHealth = 0f;
            Die();
        }
    }

    void Die()
    {
        Destroy(gameObject);
    }
}
